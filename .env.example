# Generación: al menos un proveedor para el motor de noticias.
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=

# Motor de síntesis vocal (TTS): kokoro (predeterminado local offline), elevenlabs o edge
TTS_ENGINE=kokoro
KOKORO_VOICE=em_alex
KOKORO_SPEED=1.05

# Vacío: Facebook + Instagram, y TikTok/YouTube si hay credenciales.
# Para seleccionar solo dos redes: facebook,instagram
PUBLISH_PLATFORMS=
META_GRAPH_VERSION=v21.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Integraciones conservadas de main.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=unlisted
# graphics: SVG y tipografía, sin descargar/generar imágenes.
# hybrid (predeterminado): permite imágenes como apoyo; mantiene escenas gráficas.
VIDEO_VISUAL_MODE=hybrid
